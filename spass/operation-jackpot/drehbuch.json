      "musik": "gedaempft",
      "saetze": [
        { "wer": "tuersteher", "text": "Halloween, hm? Als was geht ihr?", "say": "Hälloween, hm? Als was geht ihr?" },
        { "wer": "yannick",    "text": "Gar nicht verkleidet. Wir sind Unternehmensberater." },
        { "wer": "tuersteher", "text": "Gruselig. Rein mit euch.", "pause": 0.6 }
