      "musik": "heist",
      "saetze": [
        { "wer": "yannick", "text": "Meine Herren, willkommen zur Lagebesprechung.", "say": "Meine Herren, willkommen zur Lage-Besprechung." },
        { "wer": "aurel",   "text": "Ich bin der Einzige hier." },
        { "wer": "yannick", "text": "Phase eins: Wir fahren zur Spielbank Neuenkirchen.", "say": "Phase eins: Wir fahren zur Spielbank Neuenkirrchen." },
        { "wer": "yannick", "text": "Phase zwei: Wir machen einen dicken Haufen Geld.", "pause": 0.3 },
        { "wer": "aurel",   "text": "Und wie genau?" },
        { "wer": "yannick", "text": "Phase zwei ist … ein dicker Haufen Geld.", "say": "Phase zwei ist, ein dicker Haufen Geld." },
        { "wer": "aurel",   "text": "Genial. Und Phase drei?", "say": "Ge-nial. Und Phase drei?" },
        { "wer": "yannick", "text": "Heimfahren. Shisha.", "say": "Heimfahren. Schischa." },
        { "wer": "aurel",   "text": "Das ist der beste Plan, den ich je gesehen habe." },
        { "wer": "yannick", "text": "Ich habe sogar eine Stakeholder-Analyse vom Roulettetisch gemacht.", "say": "Ich habe sogar eine Steikholder-Analyse vom Rulett-Tisch gemacht." },
        { "wer": "aurel",   "text": "Der Tisch hat keine Stakeholder.", "say": "Der Tisch hat keine Steikholder." },
        { "wer": "yannick", "text": "Noch nicht.", "pause": 0.3 }
      ]
    },
    {
      "id": "fahrt", "vorlauf": 1.6, "nachlauf": 1.2,
      "geraeusche": [["motor", "start", 0.0, "ende"], ["gong", "S0", -0.7], ["gong", "S4", -0.7]],
      "musik": "heist",
      "saetze": [
        { "wer": "navi",    "text": "Route wird berechnet. Ziel: Spielbank Neuenkirchen. Voraussichtliche Ankunft: reich.", "say": "Route wird berechnet. Ziel: Spielbank Neuenkirrchen. Voraussichtliche Ankunft: reich." },
        { "wer": "aurel",   "text": "Hast du die Snacks?", "pause": 0.4, "say": "Hast du die Snäcks?" },
        { "wer": "yannick", "text": "Ich habe einen Projektplan." },
        { "wer": "aurel",   "text": "Kann man den essen?" },
        { "wer": "navi",    "text": "In dreihundert Metern rechts abbiegen. Bitte lassen Sie Ihre Würde im Fahrzeug.", "pause": 1.0 }
      ]
    },
    {
      "id": "eingang", "vorlauf": 2.4, "nachlauf": 1.8,
      "geraeusche": [["neon", "start", 0.0, "ende"], ["schritte", "start", 0.0], ["tuer", "ende", -1.6]],
      "musik": "gedaempft",
      "saetze": [
        { "wer": "tuersteher", "text": "Halloween, hm? Als was geht ihr?", "say": "Hälloween, hm? Als was geht ihr?" },
        { "wer": "yannick",    "text": "Gar nicht verkleidet. Wir sind Unternehmensberater." },
        { "wer": "tuersteher", "text": "Gruselig. Rein mit euch.", "pause": 0.6 }
      ]
    },
    {
      "id": "roulette", "vorlauf": 1.2, "nachlauf": 2.6,
      "geraeusche": [["casino", "start", 0.0, "ende"], ["chips", "S2", 1.2], ["kugel", "S4", 1.6, "S5"], ["trommel", "S5", -2.4, "S5"], ["fanfare", "S5e", 0.1], ["muenzen", "S5e", 0.1]],
      "musik": "heist",
      "musik_pause": ["S4", 1.0, "S5e", 0.0],
      "saetze": [
        { "wer": "croupier", "text": "Faites vos jeux. Machen Sie Ihr Spiel.", "say": "Fett wo schöh. Machen Sie Ihr Spiel." },
        { "wer": "yannick",  "text": "Laut meiner Excel-Tabelle setzen wir auf …", "say": "Laut meiner Exzel-Tabelle setzen wir auf" },
        { "wer": "aurel",    "text": "Heute ist der Einunddreißigste. Alles auf die Einunddreißig." },
        { "wer": "yannick",  "text": "Das ist methodisch überhaupt nicht belastbar." },
        { "wer": "croupier", "text": "Rien ne va plus. Nichts geht mehr.", "say": "Rjäng nö wa plü. Nichts geht mehr." },
        { "wer": "croupier", "text": "Einunddreißig. Schwarz. Ungerade.", "pause": 7.0 },
        { "wer": "aurel",    "text": "Jaaa! Phase zwei erledigt!", "pause": 0.9, "say": "Jaaa! Phase zwei erledigt!" },
        { "wer": "yannick",  "text": "Ich nenne das: erfolgreiches Erwartungsmanagement." }
      ]
    },
    {
      "id": "heim", "vorlauf": 1.4, "nachlauf": 1.6,
      "geraeusche": [["motor", "start", 0.0, "ende"], ["gong", "S0", -0.7]],
      "musik": "heist",
      "saetze": [
        { "wer": "navi",  "text": "Route nach Hause. Herzlichen Glückwunsch. Sie sind jetzt vermögend." },
        { "wer": "aurel", "text": "Ab in Phase drei.", "pause": 0.5 }
      ]
    },
    {
      "id": "shisha", "vorlauf": 3.0, "nachlauf": 3.0,
      "geraeusche": [["blubbern", "start", 0.6, "ende"]],
      "musik": "lounge",
      "saetze": [
        { "wer": "aurel",   "text": "Auf die beste Lagebesprechung aller Zeiten.", "say": "Auf die beste Lage-Besprechung aller Zeiten." },
        { "wer": "yannick", "text": "Auf Phase drei.", "pause": 0.3 },
        { "wer": "aurel",   "text": "Und nächstes Jahr? Einunddreißigster Oktober, zweitausendsiebenundzwanzig?", "pause": 2.6 },
        { "wer": "yannick", "text": "Dann setzen wir auf die Siebenundzwanzig." },
        { "wer": "aurel",   "text": "Methodisch belastbar.", "pause": 0.4 }
      ]
    },
    {
      "id": "abspann", "vorlauf": 1.4, "nachlauf": 8.5,
      "geraeusche": [["boom", "start", 0.2]],
      "musik": "heist",
      "saetze": [
        { "wer": "erzaehler", "text": "Operation Jackpot." },
        { "wer": "erzaehler", "text": "Demnächst.", "pause": 0.5 },
        { "wer": "erzaehler", "text": "Vielleicht.", "pause": 0.5 },
        { "wer": "erzaehler", "text": "Eher nicht.", "pause": 0.6 }
      ]
    }
