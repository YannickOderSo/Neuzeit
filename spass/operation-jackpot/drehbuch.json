      "musik": "heist",
      "saetze": [
        { "wer": "yannick", "text": "Meine Herren, willkommen zur Lagebesprechung.", "say": "Meine Herren, willkommen zur Lage-Besprechung." },
        { "wer": "aurel",   "text": "Ich bin der Einzige hier." },
        { "wer": "yannick", "text": "Phase eins: Wir fahren zur Spielbank Neunkirchen.", "say": "Phase eins: Wir fahren zur Spielbank Neun-Kirchen." },
        { "wer": "yannick", "text": "Phase zwei: Wir machen einen dicken Haufen Geld.", "pause": 0.3 },
        { "wer": "aurel",   "text": "Und wie genau?" },
        { "wer": "yannick", "text": "Phase zwei ist … ein dicker Haufen Geld.", "say": "Phase zwei ist, ein dicker Haufen Geld." },
        { "wer": "aurel",   "text": "Genial. Und Phase drei?", "say": "Ge-nial. Und Phase drei?" },
        { "wer": "yannick", "text": "Heimfahren. Shisha.", "say": "Heimfahren. Schischa." },
        { "wer": "aurel",   "text": "Das ist der beste Plan, den ich je gesehen habe." },
        { "wer": "yannick", "text": "Ich habe sogar eine Stakeholder-Analyse vom Spielautomaten gemacht.", "say": "Ich habe sogar eine Steikholder-Analyse vom Spielautomaten gemacht." },
        { "wer": "aurel",   "text": "Der Automat hat keine Stakeholder.", "say": "Der Automat hat keine Steikholder." },
        { "wer": "yannick", "text": "Noch nicht.", "pause": 0.3 }
      ]
    },
    {
      "id": "fahrt", "vorlauf": 1.6, "nachlauf": 1.2,
      "geraeusche": [["motor", "start", 0.0, "ende"], ["gong", "S0", -0.7], ["gong", "S4", -0.7]],
      "musik": "heist",
      "saetze": [
        { "wer": "navi",    "text": "Route wird berechnet. Ziel: Spielbank Neunkirchen, Saarland. Voraussichtliche Ankunft: reich.", "say": "Route wird berechnet. Ziel: Spielbank Neun-Kirchen, Saarland. Voraussichtliche Ankunft: reich." },
        { "wer": "aurel",   "text": "Hast du die Snacks?", "pause": 0.4, "say": "Hast du die Snäcks?" },
        { "wer": "yannick", "text": "Ich habe einen Projektplan." },
        { "wer": "aurel",   "text": "Kann man den essen?" },
        { "wer": "navi",    "text": "In dreihundert Metern rechts abbiegen. Bitte lassen Sie Ihre Würde im Fahrzeug.", "pause": 1.0 }
      ]
    },
    {
      "id": "eingang", "vorlauf": 2.4, "nachlauf": 2.0,
