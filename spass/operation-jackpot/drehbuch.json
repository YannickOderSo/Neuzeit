    {
      "id": "automaten", "vorlauf": 2.6, "nachlauf": 2.6,
      "geraeusche": [["casino", "start", 0.0, "ende"], ["touch", "S3e", 0.5], ["feature", "W0e", 0.2],
                     ["trommel", "W4e", -1.8, "W4e"], ["fanfare", "W4e", 0.05], ["klingel", "W4e", 0.1], ["muenzen", "W4e", 0.4],
                     ["schritte", "S7", -2.2]],
      "musik": "heist",
      "musik_pause": ["W0e", 0.0, "W4e", 2.5],
      "saetze": [
        { "wer": "aurel",   "text": "Da ist er. Clover Link.", "say": "Da ist er. Klouwer Link." },
        { "wer": "yannick", "text": "Laut meiner Excel-Tabelle nehmen wir Automat zwölf. Beste Auszahlungskurve.", "say": "Laut meiner Exzel-Tabelle nehmen wir Automat zwölf. Beste Auszahlungskurve." },
        { "wer": "aurel",   "text": "Heute ist der Einunddreißigste. Ich nehm die Einunddreißig." },
        { "wer": "yannick", "text": "Das ist methodisch überhaupt nicht belastbar." },
        { "wer": "yannick", "text": "Fünf Kleeblätter. Das Clover Feature.", "pause": 4.2, "say": "Fünf Kleeblätter. Das Klouwer Fietscher." },
        { "wer": "yannick", "stimme": "yannick_leise", "text": "Rote Kleeblätter auf Walze eins und drei. Fehlt nur noch die Fünf.", "pause": 4.9 },
        { "wer": "aurel",   "text": "Jaaa! Phase zwei erledigt!", "pause": 4.7 },
        { "wer": "aufsicht", "text": "Herzlichen Glückwunsch. Grand Jackpot an Automat einunddreißig.", "pause": 2.4, "say": "Herzlichen Glückwunsch! Grand Jackpot an Automat einunddreißig." },
        { "wer": "yannick", "text": "Ich nenne das: erfolgreiches Erwartungsmanagement." }
      ],
      "walzen": [
        { "anker": "S3e", "versatz": 1.3, "lauf": 1.2,
          "neu": [[0, 1, "2,00"], [1, 0, "1,00"], [2, 2, "MINI"], [3, 1, "5,00"], [4, 0, "3,00"]] },
        { "anker": "S4e", "versatz": 0.4, "lauf": 0.7, "abstand": 0.12, "neu": [] },
        { "anker": "S4e", "versatz": 1.9, "lauf": 0.7, "abstand": 0.12, "neu": [[0, 0, "GRAND"], [3, 2, "2,00"]] },
        { "anker": "S4e", "versatz": 3.4, "lauf": 0.7, "abstand": 0.12, "neu": [[2, 0, "GRAND"], [1, 2, "MINOR"]] },
        { "anker": "S5e", "versatz": 0.5, "lauf": 0.7, "abstand": 0.12, "spannung": 1.8, "neu": [[4, 2, "GRAND"]] }
      ]
    },
    {
      "id": "heim", "vorlauf": 1.4, "nachlauf": 1.6,
      "geraeusche": [["motor", "start", 0.0, "ende"], ["gong", "S0", -0.7]],
      "musik": "heist",
      "saetze": [
        { "wer": "navi",  "text": "Route nach Hause. Herzlichen Glückwunsch. Sie sind jetzt vermögend." },
        { "wer": "aurel", "text": "Ab in Phase drei.", "pause": 0.5 }
      ]
    },
    {
      "id": "shisha", "vorlauf": 3.2, "nachlauf": 3.0,
      "geraeusche": [["xkah", "start", 1.0], ["blubbern", "S0e", 0.4, "ende"]],
      "musik": "lounge",
      "saetze": [
        { "wer": "yannick", "text": "Xkah Pro. Keine Kohle, kein Stress. Timer: einunddreißig Minuten.", "say": "Iks-Kah Pro. Keine Kohle, kein Stress. Timer: einunddreißig Minuten." },
        { "wer": "aurel",   "text": "Auf die beste Lagebesprechung aller Zeiten.", "pause": 1.4, "say": "Auf die beste Lage-Besprechung aller Zeiten." },
        { "wer": "yannick", "text": "Auf Phase drei.", "pause": 0.3 },
        { "wer": "aurel",   "text": "Und nächstes Jahr? Einunddreißigster Oktober, zweitausendsiebenundzwanzig?", "pause": 2.0 },
        { "wer": "yannick", "text": "Dann nehmen wir Automat siebenundzwanzig.", "pause": 2.6 },
        { "wer": "aurel",   "text": "Methodisch belastbar.", "pause": 0.4 }
      ]
    },
    {
      "id": "abspann", "vorlauf": 1.4, "nachlauf": 8.5,
      "geraeusche": [["boom", "start", 0.2]],
      "musik": "heist",
      "saetze": [
        { "wer": "erzaehler", "text": "Operation Jackpot." },
        { "wer": "erzaehler", "text": "Demnächst.", "pause": 0.5 },
        { "wer": "erzaehler", "text": "Vielleicht.", "pause": 0.5 },
        { "wer": "erzaehler", "text": "Eher nicht.", "pause": 0.6 }
      ]
    }
  ]
